# Copy this file to .env and adjust values as needed. Never commit the real
# .env file (it's already in .gitignore).

# Path to the SQLite database file - it's created automatically on first run,
# no separate database setup needed. Relative paths are resolved from the
# backend/ folder.
SQLITE_DB_PATH=./data/hireflow.sqlite

# Which port the Express server listens on
PORT=4000

# Frontend URL, used for CORS - update to your deployed frontend URL in production
FRONTEND_URL=http://localhost:5173

# --- Auth ---
# There is no external auth provider (no Firebase, no OAuth). Two fixed
# accounts are seeded into the database on first startup - one HR account,
# one candidate account - using the credentials below. Change these to
# whatever you want to log in with; the app will pick up the new values
# next time it restarts (it updates the seeded row's role, and a changed
# username/password takes effect immediately since login checks these env
# values directly, not a stored password hash).
HR_USERNAME=hr
HR_PASSWORD=hr123

CANDIDATE_USERNAME=candidate
CANDIDATE_PASSWORD=candidate123

# Secret used to sign login session tokens (JWTs). Use any long random
# string - it doesn't need to be memorable, just kept secret.
JWT_SECRET=change-this-to-a-long-random-string
